{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "declaration": true,
    "outDir": "../dist",
    "rootDir": ".."
  },
  "include": [
    "./**/*.ts",
    "../lib/**/*.ts",
    "../src/lib/**/*.ts",
    "../src/store/**/*.ts",
    "../src/types/**/*.ts"
  ],
  "exclude": [
    "./**/*.spec.ts",
    "../src/**/*.spec.ts"
  ]
}
