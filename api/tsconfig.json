{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "declaration": true,
    "emitDeclarationOnly": true,
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@lib/*": [
        "lib/*"
      ]
    }
  },
  "include": [
    "./**/*.ts",
    "../lib/**/*.ts",
    "../src/lib/**/*.ts",
    "../src/store/**/*.ts",
    "../src/types/**/*.ts"
  ],
  "exclude": [
    "./**/*.spec.ts",
    "../src/**/*.spec.ts"
  ]
}
