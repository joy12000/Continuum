{
  "name": "continuum",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    { "src": "api/v1.ts", "use": "@vercel/node" },
    { "src": "api/v1/threads/index.ts", "use": "@vercel/node" },
    { "src": "api/v1/threads/generate.ts", "use": "@vercel/node" },
    { "src": "api/v1/threads/notes/[noteId]/connections.ts", "use": "@vercel/node" },
    { "src": "api/v1/threads/notes/[noteId]/backlinks.ts", "use": "@vercel/node" }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/|_next/|assets/|favicon.ico|sw.js|manifest.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}