{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "lib": [
      "ES2021",
      "DOM",
      "WebWorker"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@lib/*": [
        "lib/*"
      ]
    },
    "skipLibCheck": true
  },
  "include": [
    "src",
    "lib"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ],
  "references": [
    { "path": "./api" }
  ]
}